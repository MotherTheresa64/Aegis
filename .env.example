# Core
AEGIS_ENV=development
# Use a unique random value of at least 32 characters in production.
AEGIS_SECRET_KEY=change-me-in-production
AEGIS_ACCESS_TOKEN_MINUTES=60
AEGIS_CORS_ORIGINS=http://localhost:5173
AEGIS_INLINE_JOBS=false
AEGIS_REALTIME_TICKET_SECONDS=60
# Reverse proxies that append to X-Forwarded-For in front of the API (Render: 1, none: 0).
AEGIS_TRUSTED_PROXY_HOPS=0
# Bearer token required for /metrics in production; leave empty to disable the endpoint there.
AEGIS_METRICS_TOKEN=
# Run a Celery worker inside the API process (hosts without a separate worker service).
AEGIS_EMBEDDED_WORKER=false

# Database
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis

# Redis / queue (broker and result backend default to REDIS_URL when unset)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
